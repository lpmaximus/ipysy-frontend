# === Environment (SEGURANÇA — nunca versionar arquivos com segredos reais)
# .env.local  → desenvolvimento local (yarn dev)
# .env.prod   → produção Hetzner (docker compose --env-file .env.prod)
# Nenhum arquivo .env com segredos reais deve ser versionado.
.env
.env.local
.env.prod
.env.prod.local
.env.staging
.env.staging.local
.env.runtime
*.env
.env.*

# === Testes ===
coverage/
test-results/
playwright-report/
playwright/.cache/

# === Docker runtime (gerado pelo Vault — nunca versionar) ===
