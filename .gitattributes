# Garante LF para scripts shell (evita CRLF no Windows)
*.sh text eol=lf

# Normaliza line endings
* text=auto
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.env.* text eol=lf

# Binários — sem conversão
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
